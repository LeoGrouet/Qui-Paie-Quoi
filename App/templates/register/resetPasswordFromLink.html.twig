{% extends "base.html.twig" %}

{% trans_default_domain 'authentication' %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/registration.css') }}">
{% endblock %}

{% block body %}
<h2 class="authentication_form_title">{{'resetPassword'|trans}}</h2>
  
<div class="authentication_form">
      {{ form_start(form) }}

            <span class="authentication_form_field">
              {{ form_label(form.newPassword.first) }}
              {{ form_widget(form.newPassword.first) }}
              <div class="authentication_form_error">
              {{ form_errors(form.newPassword.first) }}
              </div>
            </span>

            <span class="authentication_form_field">
              {{ form_label(form.newPassword.second) }}
              {{ form_widget(form.newPassword.second) }}
              <div class="authentication_form_error">
              {{ form_errors(form.newPassword.second) }}
              </div>
            </span>

            <footer class="authentication_form_field">
                {{ form_row(form.submit) }}
            </footer>
            
      {{ form_end(form) }}
    </div>

{% endblock %}