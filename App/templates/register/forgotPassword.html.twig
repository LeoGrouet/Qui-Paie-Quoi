{% extends "base.html.twig" %}

{% trans_default_domain 'authentication' %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('css/registration.css') }}">
{% endblock %}

{% block body %}
<h2 class="authentication_form_title">{{'resetPassword'|trans}}</h2>
  
<div class="authentication_form">
      {{ form_start(form) }}
          
            <span class="authentication_form_field">
              {{ form_label(form.email) }}
              {{ form_widget(form.email) }}
              <div class="authentication_form_error">
              {{ form_errors(form.email) }}
              </div>
            </span>

            <footer class="authentication_form_field">
                {{ form_row(form.submit) }}
                <span class="authentication_form_redirect"> <a href="{{ path ('groups_home') }}">{{'backToSignIn'|trans}}</a> </span>
            </footer>
            
      {{ form_end(form) }}
    </div>

{% endblock %}