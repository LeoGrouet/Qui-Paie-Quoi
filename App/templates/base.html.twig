<!DOCTYPE html>
<html>
    <head>
    
        <meta charset="UTF-8">
            <title>{% block title %}Qui paie Quoi{% endblock %}</title>
            <link rel="stylesheet" href="{{ asset('css/reset.css') }}">
            <link rel="stylesheet" href="{{ asset('css/global.css') }}">
        <meta
            name="viewport"
            content="width=device-width, height=device-height, initial-scale=1.0, user-scalable=0, minimum-scale=1.0, maximum-scale=1.0"
        />
        {% block stylesheets %}
        {% endblock %}
        {% block javascripts %}
        <script defer src="{{ asset('js/flashMessageDisplayer.js') }}"></script>
        <script defer src="{{ asset('js/menuNavBar.js') }}"></script>

        {% endblock %}

    </head>
    <body>

        <header class="title">

            <a href="{{ path ('groups_home') }}">
                <h2 class="qui-paie-quoi">Qui Paie Quoi</h2>
            </a>

            {% if is_granted('ROLE_USER') %}

                <menu class="user_nav">

                    {# <svg class="user_nav_profil">{{ux_icon('lucide:user') }}</svg> #}

                    {# <div class="user_nav_burger">
                        <a href="{{ path ('forgot_password')}}">Modifier mon mot de passe</p>
                    </div> #}

                    <a href="{{ path ('_logout_main') }}">
                        <svg>{{ ux_icon('lucide:log-out') }}</svg>
                    </a>

                </menu>

            {% endif %}

        </header>

        <div class = "flash-message">

            {% for message in app.flashes('notice') %}
                <div class="flash-notice">
                    {{ message }}
                </div>
            {% endfor %}

             {% for message in app.flashes('success') %}
                <div class="flash-success">
                    {{ message }}
                </div>
            {% endfor %}

        </div>

        {% block body %}{% endblock %}
    </body>
</html>